# Site language (ISO 639-1 code, e.g., en, id, de, fr, es, ja, zh)
SITE_LANGUAGE=en

# Personal Information
SITE_AUTHOR_NAME="Udayan Mishra"
SITE_AUTHOR_TITLE="Junior Software Engineer"
SITE_AUTHOR_BIO="Junior Software Engineer at Reelax. B.Tech in Computer Science, Manipal University Jaipur (2022 to 2026). Based in Delhi, working from Noida."
SITE_AUTHOR_EMAIL=udayanmishra354@gmail.com
